\mt1 ΚΑΤΑ ΜΑΡΚΟΝ  
\c 16  
\p
\v 1 \w Καὶ\w* \w διαγενομένου\w* \w τοῦ\w* \w σαββάτου\w* ⸀\w Μαρία\w*\f + \fr 16:1 \ft Μαρία Treg NA28 RP ] ἡ Μαρία WH \f* \w ἡ\w* \w Μαγδαληνὴ\w* \w καὶ\w* \w Μαρία\w* ⸂\w ἡ\w* \w τοῦ\w*\f + \fr 16:1 \ft ἡ τοῦ WH Treg NA28 ] – RP\f* \w Ἰακώβου\w* \w καὶ\w* \w Σαλώμη\w* \w ἠγόρασαν\w* \w ἀρώματα\w* \w ἵνα\w* \w ἐλθοῦσαι\w* \w ἀλείψωσιν\w* \w αὐτόν\w*.  
\v 2 \w καὶ\w* \w λίαν\w* \w πρωῒ\w* ⸂\w τῇ\w* \w μιᾷ\w* \w τῶν\w*\f + \fr 16:2 \ft τῇ μιᾷ τῶν WH NA28 ] μιᾷ τῶν Treg; τῆς μιᾶς RP\f* \w σαββάτων\w* \w ἔρχονται\w* \w ἐπὶ\w* \w τὸ\w* \w μνημεῖον\w* \w ἀνατείλαντος\w* \w τοῦ\w* \w ἡλίου\w*.  
\v 3 \w καὶ\w* \w ἔλεγον\w* \w πρὸς\w* \w ἑαυτάς\w*· \w Τίς\w* \w ἀποκυλίσει\w* \w ἡμῖν\w* \w τὸν\w* \w λίθον\w* ⸀\w ἐκ\w*\f + \fr 16:3 \ft ἐκ WH NA28 RP ] ἀπὸ Treg\f* \w τῆς\w* \w θύρας\w* \w τοῦ\w* \w μνημείου\w*;  
\v 4 \w καὶ\w* \w ἀναβλέψασαι\w* \w θεωροῦσιν\w* \w ὅτι\w* ⸀\w ἀποκεκύλισται\w*\f + \fr 16:4 \ft ἀποκεκύλισται NA28 RP ] ἀνακεκύλισται WH Treg\f* \w ὁ\w* \w λίθος\w*, \w ἦν\w* \w γὰρ\w* \w μέγας\w* \w σφόδρα\w*.  
\v 5 \w καὶ\w* \w εἰσελθοῦσαι\w* \w εἰς\w* \w τὸ\w* \w μνημεῖον\w* \w εἶδον\w* \w νεανίσκον\w* \w καθήμενον\w* \w ἐν\w* \w τοῖς\w* \w δεξιοῖς\w* \w περιβεβλημένον\w* \w στολὴν\w* \w λευκήν\w*, \w καὶ\w* \w ἐξεθαμβήθησαν\w*.  
\v 6 \w ὁ\w* \w δὲ\w* \w λέγει\w* \w αὐταῖς\w*· \w Μὴ\w* \w ἐκθαμβεῖσθε\w*· \w Ἰησοῦν\w* \w ζητεῖτε\w* \w τὸν\w* \w Ναζαρηνὸν\w* \w τὸν\w* \w ἐσταυρωμένον\w*· \w ἠγέρθη\w*, \w οὐκ\w* \w ἔστιν\w* \w ὧδε\w*· \w ἴδε\w* \w ὁ\w* \w τόπος\w* \w ὅπου\w* \w ἔθηκαν\w* \w αὐτόν\w*·  
\v 7 \w ἀλλὰ\w* \w ὑπάγετε\w* \w εἴπατε\w* \w τοῖς\w* \w μαθηταῖς\w* \w αὐτοῦ\w* \w καὶ\w* \w τῷ\w* \w Πέτρῳ\w* \w ὅτι\w* \w Προάγει\w* \w ὑμᾶς\w* \w εἰς\w* \w τὴν\w* \w Γαλιλαίαν\w*· \w ἐκεῖ\w* \w αὐτὸν\w* \w ὄψεσθε\w*, \w καθὼς\w* \w εἶπεν\w* \w ὑμῖν\w*.  
\v 8 \w καὶ\w* \w ἐξελθοῦσαι\w* \w ἔφυγον\w* \w ἀπὸ\w* \w τοῦ\w* \w μνημείου\w*, \w εἶχεν\w* ⸀\w γὰρ\w*\f + \fr 16:8 \ft ⸀γὰρ WH Treg NA28 ] δὲ RP \f* \w αὐτὰς\w* \w τρόμος\w* \w καὶ\w* \w ἔκστασις\w*· \w καὶ\w* \w οὐδενὶ\w* \w οὐδὲν\w* εἶπαν, \w ἐφοβοῦντο\w* ⸁\w γάρ\w*\f + \fr 16:8 \ft ⸁γάρ WH NA28 ] + 9–20 Treg RP; + Intermediate ending and 9–20 NIV.\f* ⟦\w Πάντα\w* \w δὲ\w* \w τὰ\w* παρηγγελμένα \w τοῖς\w* \w περὶ\w* \w τὸν\w* \w Πέτρον\w* \w συντόμως\w* ἐξήγγειλαν. \w μετὰ\w* \w δὲ\w* \w ταῦτα\w* \w καὶ\w* \w αὐτὸς\w* \w ὁ\w* \w Ἰησοῦς\w* \w ἀπὸ\w* \w ἀνατολῆς\w* \w καὶ\w* \w ἄχρι\w* δύσεως \w ἐξαπέστειλεν\w* \w διʼ\w* \w αὐτῶν\w* \w τὸ\w* \w ἱερὸν\w* \w καὶ\w* \w ἄφθαρτον\w* \w κήρυγμα\w* \w τῆς\w* \w αἰωνίου\w* \w σωτηρίας\w*. \w ἀμήν\w*.⟧  
\v 9 \f + \fr 16:9 \ft παρʼ ⟦WH⟧ Treg NA28 ] ἀφʼ RP\f* \w Ἀναστὰς\w* \w δὲ\w* \w πρωῒ\w* \w πρώτῃ\w* \w σαββάτου\w* \w ἐφάνη\w* \w πρῶτον\w* \w Μαρίᾳ\w* \w τῇ\w* \w Μαγδαληνῇ\w*, ⸀\w παρʼ\w* \w ἧς\w* \w ἐκβεβλήκει\w* \w ἑπτὰ\w* \w δαιμόνια\w*.  
\v 10 \w ἐκείνη\w* \w πορευθεῖσα\w* \w ἀπήγγειλεν\w* \w τοῖς\w* \w μετʼ\w* \w αὐτοῦ\w* \w γενομένοις\w* πενθοῦσι \w καὶ\w* \w κλαίουσιν\w*·  
\v 11 \w κἀκεῖνοι\w* \w ἀκούσαντες\w* \w ὅτι\w* \w ζῇ\w* \w καὶ\w* \w ἐθεάθη\w* \w ὑπʼ\w* \w αὐτῆς\w* \w ἠπίστησαν\w*.  
\v 12 \w Μετὰ\w* \w δὲ\w* \w ταῦτα\w* \w δυσὶν\w* \w ἐξ\w* \w αὐτῶν\w* \w περιπατοῦσιν\w* \w ἐφανερώθη\w* \w ἐν\w* \w ἑτέρᾳ\w* \w μορφῇ\w* \w πορευομένοις\w* \w εἰς\w* \w ἀγρόν\w*·  
\v 13 \w κἀκεῖνοι\w* \w ἀπελθόντες\w* \w ἀπήγγειλαν\w* \w τοῖς\w* \w λοιποῖς\w*· \w οὐδὲ\w* \w ἐκείνοις\w* \w ἐπίστευσαν\w*.  
\v 14 \f + \fr 16:14 \ft δὲ ⟦WH⟧ Treg NA28 ] – RP \f* στερον ⸀\w δὲ\w* \w ἀνακειμένοις\w* \w αὐτοῖς\w* \w τοῖς\w* \w ἕνδεκα\w* \w ἐφανερώθη\w*, \w καὶ\w* \w ὠνείδισεν\w* \w τὴν\w* \w ἀπιστίαν\w* \w αὐτῶν\w* \w καὶ\w* \w σκληροκαρδίαν\w* \w ὅτι\w* \w τοῖς\w* \w θεασαμένοις\w* \w αὐτὸν\w* ⸀\w ἐγηγερμένον\w*\f + \fr 16:14 \ft ἐγηγερμένον Treg NA28 RP ] + ἐκ νεκρῶν ⟦WH⟧\f* \w οὐκ\w* \w ἐπίστευσαν\w*.  
\v 15 \w καὶ\w* \w εἶπεν\w* \w αὐτοῖς\w*· \w Πορευθέντες\w* \w εἰς\w* \w τὸν\w* \w κόσμον\w* \w ἅπαντα\w* \w κηρύξατε\w* \w τὸ\w* \w εὐαγγέλιον\w* \w πάσῃ\w* \w τῇ\w* \w κτίσει\w*.  
\v 16 \w ὁ\w* \w πιστεύσας\w* \w καὶ\w* \w βαπτισθεὶς\w* \w σωθήσεται\w*, \w ὁ\w* \w δὲ\w* \w ἀπιστήσας\w* \w κατακριθήσεται\w*.  
\v 17 \w σημεῖα\w* \w δὲ\w* \w τοῖς\w* \w πιστεύσασιν\w* ⸂\w ταῦτα\w* \w παρακολουθήσει\w*\f + \fr 16:17 \ft ταῦτα παρακολουθήσει NA28 RP ] ἀκολουθήσει ταῦτα ⟦WH⟧ Treg \f*, \w ἐν\w* \w τῷ\w* \w ὀνόματί\w* \w μου\w* \w δαιμόνια\w* \w ἐκβαλοῦσιν\w*, \w γλώσσαις\w* \w λαλήσουσιν\w* ⸀\w καιναῖς\w*\f + \fr 16:17 \ft καιναῖς NA28 RP ] – ⟦WH⟧ Treg\f*  
\v 18 ⸀\w ὄφεις\w*\f + \fr 16:18 \ft ὄφεις RP ] καὶ ἐν ταῖς χερσὶν ὄφεις ⟦WH⟧ Treg NA28\f* \w ἀροῦσιν\w* \w κἂν\w* \w θανάσιμόν\w* \w τι\w* \w πίωσιν\w* \w οὐ\w* \w μὴ\w* \w αὐτοὺς\w* \w βλάψῃ\w*, \w ἐπὶ\w* \w ἀρρώστους\w* \w χεῖρας\w* \w ἐπιθήσουσιν\w* \w καὶ\w* \w καλῶς\w* \w ἕξουσιν\w*.  
\v 19 \f + \fr 16:19 \ft Ἰησοῦς ⟦WH⟧ Treg NA28 ] –RP\f* \w μὲν\w* \w οὖν\w* \w κύριος\w* ⸀\w Ἰησοῦς\w* \w μετὰ\w* \w τὸ\w* \w λαλῆσαι\w* \w αὐτοῖς\w* ἀνελήμφθη \w εἰς\w* \w τὸν\w* \w οὐρανὸν\w* \w καὶ\w* \w ἐκάθισεν\w* \w ἐκ\w* \w δεξιῶν\w* \w τοῦ\w* \w θεοῦ\w*.  
\v 20 \f + \fr 16:20 \ft σημείων ⟦WH⟧ Treg NA28 ] + Ἀμήν RP\f* κεῖνοι \w δὲ\w* \w ἐξελθόντες\w* \w ἐκήρυξαν\w* \w πανταχοῦ\w*, \w τοῦ\w* \w κυρίου\w* \w συνεργοῦντος\w* \w καὶ\w* \w τὸν\w* \w λόγον\w* \w βεβαιοῦντος\w* \w διὰ\w* \w τῶν\w* \w ἐπακολουθούντων\w* ⸀\w σημείων\w*.⟧

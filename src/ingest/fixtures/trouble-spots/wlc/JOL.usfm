\id JOL  
\h יואל 
\toc1 יואל 
\toc2 יואל 
\mt1 יואל  
\c 2  
\p
\v 1  \w תִּקְע֨וּ\w* \w שׁוֹפָ֜ר\w* \w בְּצִיּ֗וֹן\w* \w וְהָרִ֙יעוּ֙\w* \w בְּהַ֣ר\w* \w קָדְשִׁ֔י\w* \w יִרְגְּז֕וּ\w* \w כֹּ֖ל\w* \w יֹשְׁבֵ֣י\w* \w הָאָ֑רֶץ\w* \w כִּֽי\w*־\w בָ֥א\w* \w יוֹם\w*־\w יְהוָ֖ה\w* \w כִּ֥י\w* \w קָרֽוֹב\w*׃  
\v 2  \w י֧וֹם\w* \w חֹ֣שֶׁךְ\w* \w וַאֲפֵלָ֗ה\w* \w י֤וֹם\w* \w עָנָן֙\w* \w וַעֲרָפֶ֔ל\w* \w כְּשַׁ֖חַר\w* \w פָּרֻ֣שׂ\w* \w עַל\w*־\w הֶֽהָרִ֑ים\w* \w עַ֚ם\w* \w רַ֣ב\w* \w וְעָצ֔וּם\w* \w כָּמֹ֗הוּ\w* \w לֹ֤א\w* \w נִֽהְיָה֙\w* \w מִן\w*־\w הָ֣עוֹלָ֔ם\w* \w וְאַֽחֲרָיו֙\w* \w לֹ֣א\w* \w יוֹסֵ֔ף\w* \w עַד\w*־\w שְׁנֵ֖י\w* \w דּ֥וֹר\w* \w וָדֽוֹר\w*׃  
\v 3  \w לְפָנָיו֙\w* \w אָ֣כְלָה\w* \w אֵ֔שׁ\w* \w וְאַחֲרָ֖יו\w* \w תְּלַהֵ֣ט\w* \w לֶֽהָבָ֑ה\w* \w כְּגַן\w*־\w עֵ֨דֶן\w* \w הָאָ֜רֶץ\w* \w לְפָנָ֗יו\w* \w וְאַֽחֲרָיו֙\w* \w מִדְבַּ֣ר\w* \w שְׁמָמָ֔ה\w* \w וְגַם\w*־\w פְּלֵיטָ֖ה\w* \w לֹא\w*־\w הָ֥יְתָה\w* לּֽוֹ׃  
\v 4  \w כְּמַרְאֵ֥ה\w* \w סוּסִ֖ים\w* \w מַרְאֵ֑הוּ\w* \w וּכְפָרָשִׁ֖ים\w* \w כֵּ֥ן\w* \w יְרוּצֽוּן\w*׃  
\v 5  \w כְּק֣וֹל\w* \w מַרְכָּב֗וֹת\w* \w עַל\w*־\w רָאשֵׁ֤י\w* \w הֶֽהָרִים֙\w* \w יְרַקֵּד֔וּן\w* \w כְּקוֹל֙\w* \w לַ֣הַב\w* \w אֵ֔שׁ\w* \w אֹכְלָ֖ה\w* \w קָ֑שׁ\w* \w כְּעַ֣ם\w* \w עָצ֔וּם\w* \w עֱר֖וּךְ\w* \w מִלְחָמָֽה\w*׃  
\v 6  \w מִפָּנָ֖יו\w* \w יָחִ֣ילוּ\w* \w עַמִּ֑ים\w* \w כָּל\w*־\w פָּנִ֖ים\w* \w קִבְּצ֥וּ\w* \w פָארֽוּר\w*׃  
\v 7  \w כְּגִבּוֹרִ֣ים\w* \w יְרֻצ֔וּן\w* \w כְּאַנְשֵׁ֥י\w* \w מִלְחָמָ֖ה\w* \w יַעֲל֣וּ\w* \w חוֹמָ֑ה\w* \w וְאִ֤ישׁ\w* \w בִּדְרָכָיו֙\w* \w יֵֽלֵכ֔וּן\w* \w וְלֹ֥א\w* \w יְעַבְּט֖וּן\w* \w אֹרְחוֹתָֽם\w*׃  
\v 8  \w וְאִ֤ישׁ\w* \w אָחִיו֙\w* \w לֹ֣א\w* \w יִדְחָק֔וּן\w* \w גֶּ֥בֶר\w* \w בִּמְסִלָּת֖וֹ\w* \w יֵֽלֵכ֑וּן\w* \w וּבְעַ֥ד\w* \w הַשֶּׁ֛לַח\w* \w יִפֹּ֖לוּ\w* \w לֹ֥א\w* \w יִבְצָֽעוּ\w*׃  
\v 9  \w בָּעִ֣יר\w* \w יָשֹׁ֗קּוּ\w* \w בַּֽחוֹמָה֙\w* \w יְרֻצ֔וּן\w* \w בַּבָּתִּ֖ים\w* \w יַעֲל֑וּ\w* \w בְּעַ֧ד\w* \w הַחַלּוֹנִ֛ים\w* \w יָבֹ֖אוּ\w* \w כַּגַּנָּֽב\w*׃  
\v 10  \w לְפָנָיו֙\w* \w רָ֣גְזָה\w* \w אֶ֔רֶץ\w* \w רָעֲשׁ֖וּ\w* \w שָׁמָ֑יִם\w* \w שֶׁ֤מֶשׁ\w* \w וְיָרֵ֙חַ֙\w* \w קָדָ֔רוּ\w* \w וְכוֹכָבִ֖ים\w* \w אָסְפ֥וּ\w* \w נָגְהָֽם\w*׃  
\v 11  \w וַֽיהוָ֗ה\w* \w נָתַ֤ן\w* \w קוֹלוֹ֙\w* \w לִפְנֵ֣י\w* \w חֵיל֔וֹ\w* \w כִּ֣י\w* \w רַ֤ב\w* \w מְאֹד֙\w* \w מַחֲנֵ֔הוּ\w* \w כִּ֥י\w* \w עָצ֖וּם\w* \w עֹשֵׂ֣ה\w* \w דְבָר֑וֹ\w* \w כִּֽי\w*־\w גָד֧וֹל\w* \w יוֹם\w*־\w יְהוָ֛ה\w* \w וְנוֹרָ֥א\w* \w מְאֹ֖ד\w* \w וּמִ֥י\w* \w יְכִילֶֽנּוּ\w*׃  
\v 12  \w וְגַם\w*־\w עַתָּה֙\w* \w נְאֻם\w*־\w יְהוָ֔ה\w* \w שֻׁ֥בוּ\w* \w עָדַ֖י\w* \w בְּכָל\w*־\w לְבַבְכֶ֑ם\w* \w וּבְצ֥וֹם\w* \w וּבְבְכִ֖י\w* \w וּבְמִסְפֵּֽד\w*׃  
\v 13  \w וְקִרְע֤וּ\w* \w לְבַבְכֶם֙\w* \w וְאַל\w*־\w בִּגְדֵיכֶ֔ם\w* \w וְשׁ֖וּבוּ\w* \w אֶל\w*־\w יְהוָ֣ה\w* \w אֱלֹֽהֵיכֶ֑ם\w* \w כִּֽי\w*־\w חַנּ֤וּן\w* \w וְרַחוּם֙\w* \w ה֔וּא\w* \w אֶ֤רֶךְ\w* \w אַפַּ֙יִם֙\w* \w וְרַב\w*־\w חֶ֔סֶד\w* \w וְנִחָ֖ם\w* \w עַל\w*־\w הָרָעָֽה\w*׃  
\v 14  \w מִ֥י\w* \w יוֹדֵ֖עַ\w* \w יָשׁ֣וּב\w* \w וְנִחָ֑ם\w* \w וְהִשְׁאִ֤יר\w* \w אַֽחֲרָיו֙\w* \w בְּרָכָ֔ה\w* \w מִנְחָ֣ה\w* \w וָנֶ֔סֶךְ\w* \w לַיהוָ֖ה\w* \w אֱלֹהֵיכֶֽם\w*׃ פ  
\v 15  \w תִּקְע֥וּ\w* \w שׁוֹפָ֖ר\w* \w בְּצִיּ֑וֹן\w* \w קַדְּשׁוּ\w*־\w צ֖וֹם\w* \w קִרְא֥וּ\w* \w עֲצָרָֽה\w*׃  
\v 16  \w אִסְפוּ\w*־\w עָ֞ם\w* \w קַדְּשׁ֤וּ\w* \w קָהָל֙\w* \w קִבְצ֣וּ\w* \w זְקֵנִ֔ים\w* \w אִסְפוּ֙\w* \w עֽוֹלָלִ֔ים\w* \w וְיֹנְקֵ֖י\w* \w שָׁדָ֑יִם\w* \w יֵצֵ֤א\w* \w חָתָן֙\w* \w מֵֽחֶדְר֔וֹ\w* \w וְכַלָּ֖ה\w* \w מֵחֻפָּתָֽהּ\w*׃  
\v 17  \w בֵּ֤ין\w* \w הָאוּלָם֙\w* \w וְלַמִּזְבֵּ֔חַ\w* \w יִבְכּוּ֙\w* \w הַכֹּ֣הֲנִ֔ים\w* \w מְשָׁרְתֵ֖י\w* \w יְהוָ֑ה\w* \w וְֽיֹאמְר֞וּ\w* \w ח֧וּסָה\w* \w יְהוָ֣ה\w* \w עַל\w*־\w עַמֶּ֗ךָ\w* \w וְאַל\w*־\w תִּתֵּ֨ן\w* \w נַחֲלָתְךָ֤\w* \w לְחֶרְפָּה֙\w* \w לִמְשָׁל\w*־בָּ֣ם \w גּוֹיִ֔ם\w* \w לָ֚מָּה\w* \w יֹאמְר֣וּ\w* \w בָֽעַמִּ֔ים\w* \w אַיֵּ֖ה\w* \w אֱלֹהֵיהֶֽם\w*׃  
\v 18  \w וַיְקַנֵּ֥א\w* \w יְהוָ֖ה\w* \w לְאַרְצ֑וֹ\w* \w וַיַּחְמֹ֖ל\w* \w עַל\w*־\w עַמּֽוֹ\w*׃  
\v 19  \w וַיַּ֨עַן\w* \w יְהוָ֜ה\w* \w וַיֹּ֣אמֶר\w* \w לְעַמּ֗וֹ\w* \w הִנְנִ֨י\w* \w שֹׁלֵ֤חַ\w* לָכֶם֙ \w אֶת\w*־\w הַדָּגָן֙\w* \w וְהַתִּיר֣וֹשׁ\w* \w וְהַיִּצְהָ֔ר\w* \w וּשְׂבַעְתֶּ֖ם\w* \w אֹת֑וֹ\w* \w וְלֹא\w*־\w אֶתֵּ֨ן\w* \w אֶתְכֶ֥ם\w* \w ע֛וֹד\w* \w חֶרְפָּ֖ה\w* \w בַּגּוֹיִֽם\w*׃  
\v 20  \w וְֽאֶת\w*־\w הַצְּפוֹנִ֞י\w* \w אַרְחִ֣יק\w* \w מֵעֲלֵיכֶ֗ם\w* \w וְהִדַּחְתִּיו֮\w* \w אֶל\w*־\w אֶ֣רֶץ\w* \w צִיָּ֣ה\w* \w וּשְׁמָמָה֒\w* \w אֶת\w*־\w פָּנָ֗יו\w* \w אֶל\w*־\w הַיָּם֙\w* \w הַקַּדְמֹנִ֔י\w* \w וְסֹפ֖וֹ\w* \w אֶל\w*־\w הַיָּ֣ם\w* \w הָאַֽחֲר֑וֹן\w* \w וְעָלָ֣ה\w* \w בָאְשׁ֗וֹ\w* \w וְתַ֙עַל֙\w* \w צַחֲנָת֔וֹ\w* \w כִּ֥י\w* \w הִגְדִּ֖יל\w* \w לַעֲשֽׂוֹת\w*׃  
\v 21  \w אַל\w*־\w תִּֽירְאִ֖י\w* \w אֲדָמָ֑ה\w* \w גִּ֣ילִי\w* \w וּשְׂמָ֔חִי\w* \w כִּֽי\w*־\w הִגְדִּ֥יל\w* \w יְהוָ֖ה\w* \w לַעֲשֽׂוֹת\w*׃  
\v 22  \w אַל\w*־\w תִּֽירְאוּ֙\w* \w בַּהֲמ֣וֹת\w* \w שָׂדַ֔י\w* \w כִּ֥י\w* \w דָשְׁא֖וּ\w* \w נְא֣וֹת\w* \w מִדְבָּ֑ר\w* \w כִּֽי\w*־\w עֵץ֙\w* \w נָשָׂ֣א\w* \w פִרְי֔וֹ\w* \w תְּאֵנָ֥ה\w* \w וָגֶ֖פֶן\w* \w נָתְנ֥וּ\w* \w חֵילָֽם\w*׃  
\v 23  \w וּבְנֵ֣י\w* \w צִיּ֗וֹן\w* \w גִּ֤ילוּ\w* \w וְשִׂמְחוּ֙\w* \w בַּיהוָ֣ה\w* \w אֱלֹֽהֵיכֶ֔ם\w* \w כִּֽי\w*־\w נָתַ֥ן\w* לָכֶ֛ם \w אֶת\w*־\w הַמּוֹרֶ֖ה\w* \w לִצְדָקָ֑ה\w* \w וַיּ֣וֹרֶד\w* לָכֶ֗ם \w גֶּ֛שֶׁם\w* \w מוֹרֶ֥ה\w* \w וּמַלְק֖וֹשׁ\w* \w בָּרִאשֽׁוֹן\w*׃  
\v 24  \w וּמָלְא֥וּ\w* \w הַגֳּרָנ֖וֹת\w* \w בָּ֑ר\w* \w וְהֵשִׁ֥יקוּ\w* \w הַיְקָבִ֖ים\w* \w תִּיר֥וֹשׁ\w* \w וְיִצְהָֽר\w*׃  
\v 25  \w וְשִׁלַּמְתִּ֤י\w* לָכֶם֙ \w אֶת\w*־\w הַשָּׁנִ֔ים\w* \w אֲשֶׁר֙\w* \w אָכַ֣ל\w* \w הָֽאַרְבֶּ֔ה\w* \w הַיֶּ֖לֶק\w* \w וְהֶחָסִ֣יל\w* \w וְהַגָּזָ֑ם\w* \w חֵילִי֙\w* \w הַגָּד֔וֹל\w* \w אֲשֶׁ֥ר\w* \w שִׁלַּ֖חְתִּי\w* בָּכֶֽם׃  
\v 26  \w וַאֲכַלְתֶּ֤ם\w* \w אָכוֹל֙\w* \w וְשָׂב֔וֹעַ\w* \w וְהִלַּלְתֶּ֗ם\w* \w אֶת\w*־\w שֵׁ֤ם\w* \w יְהוָה֙\w* \w אֱלֹ֣הֵיכֶ֔ם\w* \w אֲשֶׁר\w*־\w עָשָׂ֥ה\w* \w עִמָּכֶ֖ם\w* \w לְהַפְלִ֑יא\w* \w וְלֹא\w*־\w יֵבֹ֥שׁוּ\w* \w עַמִּ֖י\w* \w לְעוֹלָֽם\w*׃  
\v 27  \w וִידַעְתֶּ֗ם\w* \w כִּ֣י\w* \w בְקֶ֤רֶב\w* \w יִשְׂרָאֵל֙\w* \w אָ֔נִי\w* \w וַאֲנִ֛י\w* \w יְהוָ֥ה\w* \w אֱלֹהֵיכֶ֖ם\w* \w וְאֵ֣ין\w* \w ע֑וֹד\w* \w וְלֹא\w*־\w יֵבֹ֥שׁוּ\w* \w עַמִּ֖י\w* \w לְעוֹלָֽם\w*׃ ס   
\c 3  
\p
\v 1  \w וְהָיָ֣ה\w* \w אַֽחֲרֵי\w*־\w כֵ֗ן\w* \w אֶשְׁפּ֤וֹךְ\w* \w אֶת\w*־\w רוּחִי֙\w* \w עַל\w*־\w כָּל\w*־\w בָּשָׂ֔ר\w* \w וְנִבְּא֖וּ\w* \w בְּנֵיכֶ֣ם\w* \w וּבְנֽוֹתֵיכֶ֑ם\w* \w זִקְנֵיכֶם֙\w* \w חֲלֹמ֣וֹת\w* \w יַחֲלֹמ֔וּן\w* \w בַּח֣וּרֵיכֶ֔ם\w* \w חֶזְיֹנ֖וֹת\w* \w יִרְאֽוּ\w*׃  
\v 2  \w וְגַ֥ם\w* \w עַל\w*־\w הָֽעֲבָדִ֖ים\w* \w וְעַל\w*־\w הַשְּׁפָח֑וֹת\w* \w בַּיָּמִ֣ים\w* \w הָהֵ֔מָּה\w* \w אֶשְׁפּ֖וֹךְ\w* \w אֶת\w*־\w רוּחִֽי\w*׃  
\v 3  \w וְנָֽתַתִּי֙\w* \w מֽוֹפְתִ֔ים\w* \w בַּשָּׁמַ֖יִם\w* \w וּבָאָ֑רֶץ\w* \w דָּ֣ם\w* \w וָאֵ֔שׁ\w* \w וְתִֽימֲר֖וֹת\w* \w עָשָֽׁן\w*׃  
\v 4  \w הַשֶּׁ֙מֶשׁ֙\w* \w יֵהָפֵ֣ךְ\w* \w לְחֹ֔שֶׁךְ\w* \w וְהַיָּרֵ֖חַ\w* \w לְדָ֑ם\w* \w לִפְנֵ֗י\w* \w בּ֚וֹא\w* \w י֣וֹם\w* \w יְהוָ֔ה\w* \w הַגָּד֖וֹל\w* \w וְהַנּוֹרָֽא\w*׃  
\v 5  \w וְהָיָ֗ה\w* \w כֹּ֧ל\w* \w אֲשֶׁר\w*־\w יִקְרָ֛א\w* \w בְּשֵׁ֥ם\w* \w יְהוָ֖ה\w* \w יִמָּלֵ֑ט\w* \w כִּ֠י\w* \w בְּהַר\w*־\w צִיּ֨וֹן\w* \w וּבִירוּשָׁלִַ֜ם\w* \w תִּֽהְיֶ֣ה\w* \w פְלֵיטָ֗ה\w* \w כַּֽאֲשֶׁר֙\w* \w אָמַ֣ר\w* \w יְהוָ֔ה\w* \w וּבַ֨שְּׂרִידִ֔ים\w* \w אֲשֶׁ֥ר\w* \w יְהוָ֖ה\w* \w קֹרֵֽא\w*׃   
\c 4  
\p
\v 1  \w כִּ֗י\w* \w הִנֵּ֛ה\w* \w בַּיָּמִ֥ים\w* \w הָהֵ֖מָּה\w* \w וּבָעֵ֣ת\w* \w הַהִ֑יא\w* \w אֲשֶׁ֥ר\w* \w אשוב\w* \w אֶת\w*־\w שְׁב֥וּת\w* \w יְהוּדָ֖ה\w* \w וִירוּשָׁלִָֽם\w*׃  
\v 2  \w וְקִבַּצְתִּי֙\w* \w אֶת\w*־\w כָּל\w*־ \w הַגּוֹיִ֔ם\w* \w וְה֣וֹרַדְתִּ֔ים\w* \w אֶל\w*־\w עֵ֖מֶק\w* \w יְהֽוֹשָׁפָ֑ט\w* \w וְנִשְׁפַּטְתִּ֨י\w* \w עִמָּ֜ם\w* \w שָׁ֗ם\w* \w עַל\w*־\w עַמִּ֨י\w* \w וְנַחֲלָתִ֤י\w* \w יִשְׂרָאֵל֙\w* \w אֲשֶׁ֣ר\w* \w פִּזְּר֣וּ\w* \w בַגּוֹיִ֔ם\w* \w וְאֶת\w*־\w אַרְצִ֖י\w* \w חִלֵּֽקוּ\w*׃  
\v 3  \w וְאֶל\w*־\w עַמִּ֖י\w* \w יַדּ֣וּ\w* \w גוֹרָ֑ל\w* \w וַיִּתְּנ֤וּ\w* \w הַיֶּ֙לֶד֙\w* \w בַּזּוֹנָ֔ה\w* \w וְהַיַּלְדָּ֛ה\w* \w מָכְר֥וּ\w* \w בַיַּ֖יִן\w* \w וַיִּשְׁתּֽוּ\w*׃  
\v 4  \w וְ֠גַם\w* \w מָה\w*־\w אַתֶּ֥ם\w* לִי֙ \w צֹ֣ר\w* \w וְצִיד֔וֹן\w* \w וְכֹ֖ל\w* \w גְּלִיל֣וֹת\w* \w פְּלָ֑שֶׁת\w* \w הַגְּמ֗וּל\w* \w אַתֶּם֙\w* \w מְשַׁלְּמִ֣ים\w* \w עָלָ֔י\w* \w וְאִם\w*־\w גֹּמְלִ֤ים\w* \w אַתֶּם֙\w* \w עָלַ֔י\w* \w קַ֣ל\w* \w מְהֵרָ֔ה\w* \w אָשִׁ֥יב\w* \w גְּמֻלְכֶ֖ם\w* \w בְּרֹאשְׁכֶֽם\w*׃  
\v 5  \w אֲשֶׁר\w*־\w כַּסְפִּ֥י\w* \w וּזְהָבִ֖י\w* \w לְקַחְתֶּ֑ם\w* \w וּמַֽחֲמַדַּי֙\w* \w הַטֹּבִ֔ים\w* \w הֲבֵאתֶ֖ם\w* \w לְהֵיכְלֵיכֶֽם\w*׃  
\v 6  \w וּבְנֵ֤י\w* \w יְהוּדָה֙\w* \w וּבְנֵ֣י\w* \w יְרוּשָׁלִַ֔ם\w* \w מְכַרְתֶּ֖ם\w* \w לִבְנֵ֣י\w* \w הַיְּוָנִ֑ים\w* \w לְמַ֥עַן\w* \w הַרְחִיקָ֖ם\w* \w מֵעַ֥ל\w* \w גְּבוּלָֽם\w*׃  
\v 7  \w הִנְנִ֣י\w* \w מְעִירָ֔ם\w* \w מִן\w*־\w הַ֨מָּק֔וֹם\w* \w אֲשֶׁר\w*־\w מְכַרְתֶּ֥ם\w* \w אֹתָ֖ם\w* \w שָׁ֑מָּה\w* \w וַהֲשִׁבֹתִ֥י\w* \w גְמֻלְכֶ֖ם\w* \w בְּרֹאשְׁכֶֽם\w*׃  
\v 8  \w וּמָכַרְתִּ֞י\w* \w אֶת\w*־\w בְּנֵיכֶ֣ם \w* \w וְאֶת\w*־\w בְּנֽוֹתֵיכֶ֗ם\w* \w בְּיַד֙\w* \w בְּנֵ֣י\w* \w יְהוּדָ֔ה\w* \w וּמְכָר֥וּם\w* \w לִשְׁבָאיִ֖ם\w* \w אֶל\w*־\w גּ֣וֹי\w* \w רָח֑וֹק\w* \w כִּ֥י\w* \w יְהוָ֖ה\w* \w דִּבֵּֽר\w*׃ ס  
\v 9  \w קִרְאוּ\w*־\w זֹאת֙\w* \w בַּגּוֹיִ֔ם\w* \w קַדְּשׁ֖וּ\w* \w מִלְחָמָ֑ה\w* \w הָעִ֙ירוּ֙\w* \w הַגִּבּוֹרִ֔ים\w* \w יִגְּשׁ֣וּ\w* \w יַֽעֲל֔וּ\w* \w כֹּ֖ל\w* \w אַנְשֵׁ֥י\w* \w הַמִּלְחָמָֽה\w*׃  
\v 10  \w כֹּ֤תּוּ\w* \w אִתֵּיכֶם֙\w* \w לַֽחֲרָב֔וֹת\w* \w וּמַזְמְרֹֽתֵיכֶ֖ם\w* \w לִרְמָחִ֑ים\w* \w הַֽחַלָּ֔שׁ\w* \w יֹאמַ֖ר\w* \w גִּבּ֥וֹר\w* \w אָֽנִי\w*׃  
\v 11  \w ע֣וּשׁוּ\w* \w וָבֹ֧אוּ\w* \w כָֽל\w*־\w הַגּוֹיִ֛ם\w* \w מִסָּבִ֖יב\w* \w וְנִקְבָּ֑צוּ\w* \w שָׁ֕מָּה\w* \w הַֽנְחַ֥ת\w* \w יְהוָ֖ה\w* \w גִּבּוֹרֶֽיךָ\w*׃  
\v 12  \w יֵע֙וֹרוּ֙\w* \w וְיַעֲל֣וּ\w* \w הַגּוֹיִ֔ם\w* \w אֶל\w*־\w עֵ֖מֶק\w* \w יְהֽוֹשָׁפָ֑ט\w* \w כִּ֣י\w* \w שָׁ֗ם\w* \w אֵשֵׁ֛ב\w* \w לִשְׁפֹּ֥ט\w* \w אֶת\w*־\w כָּל\w*־\w הַגּוֹיִ֖ם\w* \w מִסָּבִֽיב\w*׃  
\v 13  \w שִׁלְח֣וּ\w* \w מַגָּ֔ל\w* \w כִּ֥י\w* \w בָשַׁ֖ל\w* \w קָצִ֑יר\w* \w בֹּ֤אֽוּ\w* \w רְדוּ֙\w* \w כִּֽי\w*־\w מָ֣לְאָה\w* \w גַּ֔ת\w* \w הֵשִׁ֙יקוּ֙\w* \w הַיְקָבִ֔ים\w* \w כִּ֥י\w* \w רַבָּ֖ה\w* \w רָעָתָֽם\w*׃  
\v 14  \w הֲמוֹנִ֣ים\w* \w הֲמוֹנִ֔ים\w* \w בְּעֵ֖מֶק\w* \w הֶֽחָר֑וּץ\w* \w כִּ֤י\w* \w קָרוֹב֙\w* \w י֣וֹם\w* \w יְהוָ֔ה\w* \w בְּעֵ֖מֶק\w* \w הֶחָרֽוּץ\w*׃  
\v 15  \w שֶׁ֥מֶשׁ\w* \w וְיָרֵ֖חַ\w* \w קָדָ֑רוּ\w* \w וְכוֹכָבִ֖ים\w* \w אָסְפ֥וּ\w* \w נָגְהָֽם\w*׃  
\v 16  \w וַיהוָ֞ה\w* \w מִצִּיּ֣וֹן\w* \w יִשְׁאָ֗ג\w* \w וּמִירוּשָׁלִַ֙ם֙\w* \w יִתֵּ֣ן\w* \w קוֹל֔וֹ\w* \w וְרָעֲשׁ֖וּ\w* \w שָׁמַ֣יִם\w* \w וָאָ֑רֶץ\w* \w וַֽיהוָה֙\w* \w מַֽחֲסֶ֣ה\w* \w לְעַמּ֔וֹ\w* \w וּמָע֖וֹז\w* \w לִבְנֵ֥י\w* \w יִשְׂרָאֵֽל\w*׃  
\v 17  \w וִֽידַעְתֶּ֗ם\w* \w כִּ֣י\w* \w אֲנִ֤י\w* \w יְהוָה֙\w* \w אֱלֹ֣הֵיכֶ֔ם\w* \w שֹׁכֵ֖ן\w* \w בְּצִיּ֣וֹן\w* \w הַר\w*־\w קָדְשִׁ֑י\w* \w וְהָיְתָ֤ה\w* \w יְרוּשָׁלִַ֙ם֙\w* \w קֹ֔דֶשׁ\w* \w וְזָרִ֥ים\w* \w לֹא\w*־\w יַֽעַבְרוּ\w*־בָ֖הּ \w עֽוֹד\w*׃ ס  
\v 18  \w וְהָיָה֩\w* \w בַיּ֨וֹם\w* \w הַה֜וּא\w* \w יִטְּפ֧וּ\w* \w הֶהָרִ֣ים\w* \w עָסִ֗יס\w* \w וְהַגְּבָעוֹת֙\w* \w תֵּלַ֣כְנָה\w* \w חָלָ֔ב\w* \w וְכָל\w*־\w אֲפִיקֵ֥י\w* \w יְהוּדָ֖ה\w* \w יֵ֣לְכוּ\w* \w מָ֑יִם\w* \w וּמַעְיָ֗ן\w* \w מִבֵּ֤ית\w* \w יְהוָה֙\w* \w יֵצֵ֔א\w* \w וְהִשְׁקָ֖ה\w* \w אֶת\w*־\w נַ֥חַל\w* \w הַשִּׁטִּֽים\w*׃  
\v 19  \w מִצְרַ֙יִם֙\w* \w לִשְׁמָמָ֣ה\w* \w תִֽהְיֶ֔ה\w* \w וֶאֱד֕וֹם\w* \w לְמִדְבַּ֥ר\w* \w שְׁמָמָ֖ה\w* \w תִּֽהְיֶ֑ה\w* \w מֵֽחֲמַס֙\w* \w בְּנֵ֣י\w* \w יְהוּדָ֔ה\w* \w אֲשֶׁר\w*־\w שָׁפְכ֥וּ\w* \w דָם\w*־\w נָקִ֖יא\w* \w בְּאַרְצָֽם\w*׃  
\v 20  \w וִיהוּדָ֖ה\w* \w לְעוֹלָ֣ם\w* \w תֵּשֵׁ֑ב\w* \w וִירוּשָׁלִַ֖ם\w* \w לְד֥וֹר\w* \w וָדֽוֹר\w*׃  
\v 21  \w וְנִקֵּ֖יתִי\w* \w דָּמָ֣ם\w* \w לֹֽא\w*־\w נִקֵּ֑יתִי\w* \w וַֽיהוָ֖ה\w* \w שֹׁכֵ֥ן\w* \w בְּצִיּֽוֹן\w*׃

\id PSA  
\h תהילים 
\toc1 תהילים 
\toc2 תהילים 
\mt1 תהילים  
\c 51  
\p
\v 1  \w לַמְנַצֵּ֗חַ\w* \w מִזְמ֥וֹר\w* \w לְדָוִֽד\w*׃  
\v 2  \w בְּֽבוֹא\w*־\w אֵ֭לָיו\w* \w נָתָ֣ן\w* \w הַנָּבִ֑יא\w* \w כַּֽאֲשֶׁר\w*־\w בָּ֝֗א\w* \w אֶל\w*־\w בַּת\w*־\w שָֽׁבַע\w*׃  
\v 3  \w חָנֵּ֣נִי\w* \w אֱלֹהִ֣ים\w* \w כְּחַסְדֶּ֑ךָ\w* \w כְּרֹ֥ב\w* \w רַ֝חֲמֶ֗יךָ\w* \w מְחֵ֣ה\w* \w פְשָׁעָֽי\w*׃  
\v 4  \w הרבה\w* \w כַּבְּסֵ֣נִי\w* \w מֵעֲוֺנִ֑י\w* \w וּֽמֵחַטָּאתִ֥י\w* \w טַהֲרֵֽנִי\w*׃  
\v 5  \w כִּֽי\w*־\w פְ֭שָׁעַי\w* \w אֲנִ֣י\w* \w אֵדָ֑ע\w* \w וְחַטָּאתִ֖י\w* \w נֶגְדִּ֣י\w* \w תָמִֽיד\w*׃  
\v 6  לְךָ֤ \w לְבַדְּךָ֨\w* ׀ \w חָטָאתִי֮\w* \w וְהָרַ֥ע\w* \w בְּעֵינֶ֗יךָ\w* \w עָ֫שִׂ֥יתִי\w* \w לְ֭מַעַן\w* \w תִּצְדַּ֥ק\w* \w בְּדָבְרֶ֗ךָ\w* \w תִּזְכֶּ֥ה\w* \w בְשָׁפְטֶֽךָ\w*׃  
\v 7  \w הֵן\w*־\w בְּעָו֥וֹן\w* \w חוֹלָ֑לְתִּי\w* \w וּ֝בְחֵ֗טְא\w* \w יֶֽחֱמַ֥תְנִי\w* \w אִמִּֽי\w*׃  
\v 8  \w הֵן\w*־\w אֱ֭מֶת\w* \w חָפַ֣צְתָּ\w* \w בַטֻּח֑וֹת\w* \w וּ֝בְסָתֻ֗ם\w* \w חָכְמָ֥ה\w* \w תוֹדִיעֵֽנִי\w*׃  
\v 9  \w תְּחַטְּאֵ֣נִי\w* \w בְאֵז֣וֹב\w* \w וְאֶטְהָ֑ר\w* \w תְּ֝כַבְּסֵ֗נִי\w* \w וּמִשֶּׁ֥לֶג\w* \w אַלְבִּֽין\w*׃  
\v 10  \w תַּ֭שְׁמִיעֵנִי\w* \w שָׂשׂ֣וֹן\w* \w וְשִׂמְחָ֑ה\w* \w תָּ֝גֵ֗לְנָה\w* \w עֲצָמ֥וֹת\w* \w דִּכִּֽיתָ\w*׃  
\v 11  \w הַסְתֵּ֣ר\w* \w פָּ֭נֶיךָ\w* \w מֵחֲטָאָ֑י\w* \w וְֽכָל\w*־\w עֲוֺ֖נֹתַ֣י\w* \w מְחֵֽה\w*׃  
\v 12  \w לֵ֣ב\w* \w טָ֭הוֹר\w* \w בְּרָא\w*־לִ֣י \w אֱלֹהִ֑ים\w* \w וְר֥וּחַ\w* \w נָ֝כ֗וֹן\w* \w חַדֵּ֥שׁ\w* \w בְּקִרְבִּֽי\w*׃  
\v 13  \w אַל\w*־\w תַּשְׁלִיכֵ֥נִי\w* \w מִלְּפָנֶ֑יךָ\w* \w וְר֥וּחַ\w* \w קָ֝דְשְׁךָ֗\w* \w אַל\w*־\w תִּקַּ֥ח\w* \w מִמֶּֽנִּי\w*׃  
\v 14  \w הָשִׁ֣יבָה\w* לִּ֭י \w שְׂשׂ֣וֹן\w* \w יִשְׁעֶ֑ךָ\w* \w וְר֖וּחַ\w* \w נְדִיבָ֣ה\w* \w תִסְמְכֵֽנִי\w*׃  
\v 15  \w אֲלַמְּדָ֣ה\w* \w פֹשְׁעִ֣ים\w* \w דְּרָכֶ֑יךָ\w* \w וְ֝חַטָּאִ֗ים\w* \w אֵלֶ֥יךָ\w* \w יָשֽׁוּבוּ\w*׃  
\v 16  \w הַצִּ֘ילֵ֤נִי\w* \w מִדָּמִ֨ים\w* ׀ \w אֱֽלֹהִ֗ים\w* \w אֱלֹהֵ֥י\w* \w תְּשׁוּעָתִ֑י\w* \w תְּרַנֵּ֥ן\w* \w לְ֝שׁוֹנִ֗י\w* \w צִדְקָתֶֽךָ\w*׃  
\v 17  \w אֲ֭דֹנָי\w* \w שְׂפָתַ֣י\w* \w תִּפְתָּ֑ח\w* \w וּ֝פִ֗י\w* \w יַגִּ֥יד\w* \w תְּהִלָּתֶֽךָ\w*׃  
\v 18  \w כִּ֤י\w* ׀ \w לֹא\w*־\w תַחְפֹּ֣ץ\w* \w זֶ֣בַח\w* \w וְאֶתֵּ֑נָה\w* \w ע֝וֹלָ֗ה\w* \w לֹ֣א\w* \w תִרְצֶֽה\w*׃  
\v 19  \w זִֽבְחֵ֣י\w* \w אֱלֹהִים֮\w* \w ר֪וּחַ\w* \w נִשְׁבָּ֫רָ֥ה\w* \w לֵב\w*־\w נִשְׁבָּ֥ר\w* \w וְנִדְכֶּ֑ה\w* \w אֱ֝לֹהִ֗ים\w* \w לֹ֣א\w* \w תִבְזֶֽה\w*׃  
\v 20  \w הֵיטִ֣יבָה\w* \w בִ֭רְצוֹנְךָ\w* \w אֶת\w*־\w צִיּ֑וֹן\w* \w תִּ֝בְנֶ֗ה\w* \w חוֹמ֥וֹת\w* \w יְרוּשָׁלִָֽם\w*׃  
\v 21  \w אָ֤ז\w* \w תַּחְפֹּ֣ץ\w* \w זִבְחֵי\w*־\w צֶ֭דֶק\w* \w עוֹלָ֣ה\w* \w וְכָלִ֑יל\w* \w אָ֤ז\w* \w יַעֲל֖וּ\w* \w עַל\w*־\w מִזְבַּחֲךָ֣\w* \w פָרִֽים\w*׃

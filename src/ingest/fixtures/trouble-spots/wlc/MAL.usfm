\id MAL  
\h מלאכי 
\toc1 מלאכי 
\toc2 מלאכי 
\mt1 מלאכי  
\c 3  
\p
\v 1  \w הִנְנִ֤י\w* \w שֹׁלֵחַ֙\w* \w מַלְאָכִ֔י\w* \w וּפִנָּה\w*־\w דֶ֖רֶךְ\w* \w לְפָנָ֑י\w* \w וּפִתְאֹם֩\w* \w יָב֨וֹא\w* \w אֶל\w*־\w הֵיכָל֜וֹ\w* \w הָאָד֣וֹן\w* ׀ \w אֲשֶׁר\w*־\w אַתֶּ֣ם\w* \w מְבַקְשִׁ֗ים\w* \w וּמַלְאַ֨ךְ\w* \w הַבְּרִ֜ית\w* \w אֲשֶׁר\w*־\w אַתֶּ֤ם\w* \w חֲפֵצִים֙\w* \w הִנֵּה\w*־\w בָ֔א\w* \w אָמַ֖ר\w* \w יְהוָ֥ה\w* \w צְבָאֽוֹת\w*׃  
\v 2  \w וּמִ֤י\w* \w מְכַלְכֵּל֙\w* \w אֶת\w*־\w י֣וֹם\w* \w בּוֹא֔וֹ\w* \w וּמִ֥י\w* \w הָעֹמֵ֖ד\w* \w בְּהֵרָֽאוֹת֑וֹ\w* \w כִּֽי\w*־\w הוּא֙\w* \w כְּאֵ֣שׁ\w* \w מְצָרֵ֔ף\w* \w וּכְבֹרִ֖ית\w* \w מְכַבְּסִֽים\w*׃  
\v 3  \w וְיָשַׁ֨ב\w* \w מְצָרֵ֤ף\w* \w וּמְטַהֵר֙\w* \w כֶּ֔סֶף\w* \w וְטִהַ֤ר\w* \w אֶת\w*־\w בְּנֵֽי\w*־\w לֵוִי֙\w* \w וְזִקַּ֣ק\w* \w אֹתָ֔ם\w* \w כַּזָּהָ֖ב\w* \w וְכַכָּ֑סֶף\w* \w וְהָיוּ֙\w* \w לַֽיהוָ֔ה\w* \w מַגִּישֵׁ֥י\w* \w מִנְחָ֖ה\w* \w בִּצְדָקָֽה\w*׃  
\v 4  \w וְעָֽרְבָה֙\w* \w לַֽיהוָ֔ה\w* \w מִנְחַ֥ת\w* \w יְהוּדָ֖ה\w* \w וִירֽוּשָׁלִָ֑ם\w* \w כִּימֵ֣י\w* \w עוֹלָ֔ם\w* \w וּכְשָׁנִ֖ים\w* \w קַדְמֹנִיּֽוֹת\w*׃  
\v 5  \w וְקָרַבְתִּ֣י\w* \w אֲלֵיכֶם֮\w* \w לַמִּשְׁפָּט֒\w* \w וְהָיִ֣יתִי\w* ׀ \w עֵ֣ד\w* \w מְמַהֵ֗ר\w* \w בַּֽמְכַשְּׁפִים֙\w* \w וּבַמְנָ֣אֲפִ֔ים\w* \w וּבַנִּשְׁבָּעִ֖ים\w* \w לַשָּׁ֑קֶר\w* \w וּבְעֹשְׁקֵ֣י\w* \w שְׂכַר\w*־\w שָׂ֠כִיר\w* \w אַלְמָנָ֨ה\w* \w וְיָת֤וֹם\w* \w וּמַטֵּי\w*־\w גֵר֙\w* \w וְלֹ֣א\w* \w יְרֵא֔וּנִי\w* \w אָמַ֖ר\w* \w יְהוָ֥ה\w* \w צְבָאֽוֹת\w*׃  
\v 6  \w כִּ֛י\w* \w אֲנִ֥י\w* \w יְהוָ֖ה\w* \w לֹ֣א\w* \w שָׁנִ֑יתִי\w* \w וְאַתֶּ֥ם\w* \w בְּנֵֽי\w*־\w יַעֲקֹ֖ב\w* \w לֹ֥א\w* \w כְלִיתֶֽם\w*׃  
\v 7  \w לְמִימֵ֨י\w* \w אֲבֹתֵיכֶ֜ם\w* \w סַרְתֶּ֤ם\w* \w מֵֽחֻקַּי֙\w* \w וְלֹ֣א\w* \w שְׁמַרְתֶּ֔ם\w* \w שׁ֤וּבוּ\w* \w אֵלַי֙\w* \w וְאָשׁ֣וּבָה\w* \w אֲלֵיכֶ֔ם\w* \w אָמַ֖ר\w* \w יְהוָ֣ה\w* \w צְבָא֑וֹת\w* \w וַאֲמַרְתֶּ֖ם\w* \w בַּמֶּ֥ה\w* \w נָשֽׁוּב\w*׃  
\v 8  \w הֲיִקְבַּ֨ע\w* \w אָדָ֜ם\w* \w אֱלֹהִ֗ים\w* \w כִּ֤י\w* \w אַתֶּם֙\w* \w קֹבְעִ֣ים\w* \w אֹתִ֔י\w* \w וַאֲמַרְתֶּ֖ם\w* \w בַּמֶּ֣ה\w* \w קְבַעֲנ֑וּךָ\w* \w הַֽמַּעֲשֵׂ֖ר\w* \w וְהַתְּרוּמָֽה\w*׃  
\v 9  \w בַּמְּאֵרָה֙\w* \w אַתֶּ֣ם\w* \w נֵֽאָרִ֔ים\w* \w וְאֹתִ֖י\w* \w אַתֶּ֣ם\w* \w קֹבְעִ֑ים\w* \w הַגּ֖וֹי\w* \w כֻּלּֽוֹ\w*׃  
\v 10  \w הָבִ֨יאוּ\w* \w אֶת\w*־\w כָּל\w*־\w הַֽמַּעֲשֵׂ֜ר\w* \w אֶל\w*־\w בֵּ֣ית\w* \w הָאוֹצָ֗ר\w* \w וִיהִ֥י\w* \w טֶ֙רֶף֙\w* \w בְּבֵיתִ֔י\w* \w וּבְחָנ֤וּנִי\w* \w נָא֙\w* \w בָּזֹ֔את\w* \w אָמַ֖ר\w* \w יְהוָ֣ה\w* \w צְבָא֑וֹת\w* \w אִם\w*־\w לֹ֧א\w* \w אֶפְתַּ֣ח\w* לָכֶ֗ם \w אֵ֚ת\w* \w אֲרֻבּ֣וֹת\w* \w הַשָּׁמַ֔יִם\w* \w וַהֲרִיקֹתִ֥י\w* לָכֶ֛ם \w בְּרָכָ֖ה\w* \w עַד\w*־\w בְּלִי\w*־\w דָֽי\w*׃  
\v 11  \w וְגָעַרְתִּ֤י\w* לָכֶם֙ \w בָּֽאֹכֵ֔ל\w* \w וְלֹֽא\w*־\w יַשְׁחִ֥ת\w* לָכֶ֖ם \w אֶת\w*־\w פְּרִ֣י\w* \w הָאֲדָמָ֑ה\w* \w וְלֹא\w*־\w תְשַׁכֵּ֨ל\w* לָכֶ֤ם \w הַגֶּ֙פֶן֙\w* \w בַּשָּׂדֶ֔ה\w* \w אָמַ֖ר\w* \w יְהוָ֥ה\w* \w צְבָאֽוֹת\w*׃  
\v 12  \w וְאִשְּׁר֥וּ\w* \w אֶתְכֶ֖ם\w* \w כָּל\w*־\w הַגּוֹיִ֑ם\w* \w כִּֽי\w*־\w תִהְי֤וּ\w* \w אַתֶּם֙\w* \w אֶ֣רֶץ\w* \w חֵ֔פֶץ\w* \w אָמַ֖ר\w* \w יְהוָ֥ה\w* \w צְבָאֽוֹת\w*׃ ס  
\v 13  \w חָזְק֥וּ\w* \w עָלַ֛י\w* \w דִּבְרֵיכֶ֖ם\w* \w אָמַ֣ר\w* \w יְהוָ֑ה\w* \w וַאֲמַרְתֶּ֕ם\w* \w מַה\w*־\w נִּדְבַּ֖רְנוּ\w* \w עָלֶֽיךָ\w*׃  
\v 14  \w אֲמַרְתֶּ֕ם\w* \w שָׁ֖וְא\w* \w עֲבֹ֣ד\w* \w אֱלֹהִ֑ים\w* \w וּמַה\w*־\w בֶּ֗צַע\w* \w כִּ֤י\w* \w שָׁמַ֙רְנוּ֙\w* \w מִשְׁמַרְתּ֔וֹ\w* \w וְכִ֤י\w* \w הָלַ֙כְנוּ֙\w* \w קְדֹ֣רַנִּ֔ית\w* \w מִפְּנֵ֖י\w* \w יְהוָ֥ה\w* \w צְבָאֽוֹת\w*׃  
\v 15  \w וְעַתָּ֕ה\w* \w אֲנַ֖חְנוּ\w* \w מְאַשְּׁרִ֣ים\w* \w זֵדִ֑ים\w* \w גַּם\w*־\w נִבְנוּ֙\w* \w עֹשֵׂ֣י\w* \w רִשְׁעָ֔ה\w* \w גַּ֧ם\w* \w בָּחֲנ֛וּ\w* \w אֱלֹהִ֖ים\w* \w וַיִּמָּלֵֽטוּ\w*׃  
\v 16  \w אָ֧ז\w* \w נִדְבְּר֛וּ\w* \w יִרְאֵ֥י\w* \w יְהוָ֖ה\w* \w אִ֣ישׁ\w* \w אֶת\w*־\w רֵעֵ֑הוּ\w* \w וַיַּקְשֵׁ֤ב\w* \w יְהוָה֙\w* \w וַיִּשְׁמָ֔ע\w* \w וַ֠יִּכָּתֵב\w* \w סֵ֣פֶר\w* \w זִכָּר֤וֹן\w* \w לְפָנָיו֙\w* \w לְיִרְאֵ֣י\w* \w יְהוָ֔ה\w* \w וּלְחֹשְׁבֵ֖י\w* \w שְׁמֽוֹ\w*׃  
\v 17  \w וְהָ֣יוּ\w* לִ֗י \w אָמַר֙\w* \w יְהוָ֣ה\w* \w צְבָא֔וֹת\w* \w לַיּ֕וֹם\w* \w אֲשֶׁ֥ר\w* \w אֲנִ֖י\w* \w עֹשֶׂ֣ה\w* \w סְגֻלָּ֑ה\w* \w וְחָמַלְתִּ֣י\w* \w עֲלֵיהֶ֔ם\w* \w כַּֽאֲשֶׁר֙\w* \w יַחְמֹ֣ל\w* \w אִ֔ישׁ\w* \w עַל\w*־\w בְּנ֖וֹ\w* \w הָעֹבֵ֥ד\w* \w אֹתֽוֹ\w*׃  
\v 18  \w וְשַׁבְתֶּם֙\w* \w וּרְאִיתֶ֔ם\w* \w בֵּ֥ין\w* \w צַדִּ֖יק\w* \w לְרָשָׁ֑ע\w* \w בֵּ֚ין\w* \w עֹבֵ֣ד\w* \w אֱלֹהִ֔ים\w* \w לַאֲשֶׁ֖ר\w* \w לֹ֥א\w* \w עֲבָדֽוֹ\w*׃ ס  
\v 19  \w כִּֽי\w*־\w הִנֵּ֤ה\w* \w הַיּוֹם֙\w* \w בָּ֔א\w* \w בֹּעֵ֖ר\w* \w כַּתַּנּ֑וּר\w* \w וְהָי֨וּ\w* \w כָל\w*־\w זֵדִ֜ים\w* \w וְכָל\w*־\w עֹשֵׂ֤ה\w* \w רִשְׁעָה֙\w* \w קַ֔שׁ\w* \w וְלִהַ֨ט\w* \w אֹתָ֜ם\w* \w הַיּ֣וֹם\w* \w הַבָּ֗א\w* \w אָמַר֙\w* \w יְהוָ֣ה\w* \w צְבָא֔וֹת\w* \w אֲשֶׁ֛ר\w* \w לֹא\w*־\w יַעֲזֹ֥ב\w* \w לָהֶ֖ם\w* \w שֹׁ֥רֶשׁ\w* \w וְעָנָֽף\w*׃  
\v 20  \w וְזָרְחָ֨ה\w* לָכֶ֜ם \w יִרְאֵ֤י\w* \w שְׁמִי֙\w* \w שֶׁ֣מֶשׁ\w* \w צְדָקָ֔ה\w* \w וּמַרְפֵּ֖א\w* \w בִּכְנָפֶ֑יהָ\w* \w וִֽיצָאתֶ֥ם\w* \w וּפִשְׁתֶּ֖ם\w* \w כְּעֶגְלֵ֥י\w* \w מַרְבֵּֽק\w*׃  
\v 21  \w וְעַסּוֹתֶ֣ם\w* \w רְשָׁעִ֔ים\w* \w כִּֽי\w*־\w יִהְי֣וּ\w* \w אֵ֔פֶר\w* \w תַּ֖חַת\w* \w כַּפּ֣וֹת\w* \w רַגְלֵיכֶ֑ם\w* \w בַּיּוֹם֙\w* \w אֲשֶׁ֣ר\w* \w אֲנִ֣י\w* \w עֹשֶׂ֔ה\w* \w אָמַ֖ר\w* \w יְהוָ֥ה\w* \w צְבָאֽוֹת\w*׃ פ  
\v 22  \w זִכְר֕וּ\w* \w תּוֹרַ֖ת\w* \w מֹשֶׁ֣ה\w* \w עַבְדִּ֑י\w* \w אֲשֶׁר֩\w* \w צִוִּ֨יתִי\w* \w אוֹת֤וֹ\w* \w בְחֹרֵב֙\w* \w עַל\w*־\w כָּל\w*־\w יִשְׂרָאֵ֔ל\w* \w חֻקִּ֖ים\w* \w וּמִשְׁפָּטִֽים\w*׃  
\v 23  \w הִנֵּ֤ה\w* \w אָֽנֹכִי֙\w* \w שֹׁלֵ֣חַ\w* לָכֶ֔ם \w אֵ֖ת\w* \w אֵלִיָּ֣ה\w* \w הַנָּבִ֑יא\w* \w לִפְנֵ֗י\w* \w בּ֚וֹא\w* \w י֣וֹם\w* \w יְהוָ֔ה\w* \w הַגָּד֖וֹל\w* \w וְהַנּוֹרָֽא\w*׃  
\v 24  \w וְהֵשִׁ֤יב\w* \w לֵב\w*־\w אָבוֹת֙\w* \w עַל\w*־\w בָּנִ֔ים\w* \w וְלֵ֥ב\w* \w בָּנִ֖ים\w* \w עַל\w*־\w אֲבוֹתָ֑ם\w* \w פֶּן\w*־\w אָב֕וֹא\w* \w וְהִכֵּיתִ֥י\w* \w אֶת\w*־\w הָאָ֖רֶץ\w* \w חֵֽרֶם\w*׃
